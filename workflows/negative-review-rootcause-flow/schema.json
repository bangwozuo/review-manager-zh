{
  "workflow_id": "de_ecom_03_wf02",
  "name": "差评根因归因",
  "type": "composite",
  "skill_refs": ["de_ecom_03_sk02", "de_ecom_03_sk04"],
  "input": {
    "type": "object",
    "required": ["shop", "platform", "negatives"],
    "properties": {
      "shop": {"type": "string", "description": "店铺名"},
      "platform": {"type": "string", "description": "平台"},
      "period": {"type": "string", "description": "统计周期"},
      "negatives": {
        "type": "array",
        "description": "1-3 星差评与追评差评",
        "items": {
          "type": "object",
          "properties": {
            "star": {"type": "integer", "minimum": 1, "maximum": 3},
            "text": {"type": "string"},
            "has_image": {"type": "boolean"},
            "is_followup": {"type": "boolean", "description": "追评权重×2"}
          }
        },
        "maxItems": 1000
      },
      "last_week_dist": {"type": "object", "description": "上周各根因占比，趋势对比基线"},
      "event_note": {"type": "string", "description": "本周期业务事件，如「9-20 更换薄绒供应商」"}
    }
  },
  "output": {
    "type": "object",
    "required": ["summary", "trend", "plan"],
    "properties": {
      "summary": {
        "type": "object",
        "properties": {
          "差评总数": {"type": "integer"},
          "有效归因": {"type": "integer"},
          "疑似恶意": {"type": "integer", "description": "已剔除转申诉流"},
          "首要根因": {"type": "string"},
          "告警": {"type": "string", "description": "安全类>10%/新发根因/小样本声明"}
        }
      },
      "trend": {
        "type": "array",
        "description": "趋势对比，变化 ≤10pct 判噪声",
        "items": {
          "type": "object",
          "properties": {
            "根因": {"type": "string"},
            "本周占比": {"type": "string"},
            "上周占比": {"type": "string"},
            "判定": {"type": "string", "enum": ["↑ 恶化", "↓ 改善", "噪声（≤10pct）", "新增基线缺失"]}
          }
        }
      },
      "plan": {
        "type": "array",
        "description": "治理排期 Top3，每项带数字目标",
        "items": {
          "type": "object",
          "properties": {
            "优先级": {"type": "string"},
            "根因": {"type": "string"},
            "治理动作": {"type": "string"},
            "责任人": {"type": "string"},
            "完成时点": {"type": "string"}
          }
        }
      }
    }
  },
  "scripts": {
    "run_flow": "scripts/run_flow.py",
    "usage": "python3 scripts/run_flow.py --input input.json --outdir out"
  },
  "artifacts": ["out/差评归因治理表.xlsx", "out/根因趋势.png", "out/rootcause_flow.json"],
  "constraints": {
    "noise_band": 0.10,
    "min_sample": 10,
    "safety_alarm": 0.10,
    "followup_weight": 2,
    "forbidden": ["恶意差评计入归因", "无数字目标的治理项", "臆造业务因果"],
    "ai_label_required": true,
    "human_review_required": true
  }
}
