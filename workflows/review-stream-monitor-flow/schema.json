{
  "workflow_id": "de_ecom_03_wf01",
  "name": "评价流实时监控与分级",
  "type": "composite",
  "skill_refs": ["de_ecom_03_sk01", "de_ecom_03_sk03", "de_ecom_03_sk02", "de_ecom_03_sk04"],
  "input": {
    "type": "object",
    "required": ["shop", "platform", "monitor_date", "reviews"],
    "properties": {
      "shop": {"type": "string", "description": "店铺名"},
      "platform": {"type": "string", "description": "平台"},
      "monitor_date": {"type": "string", "description": "监控日期，如 2026-09-29"},
      "reviews": {
        "type": "array",
        "description": "当日新评价，来自平台导出/推送",
        "items": {
          "type": "object",
          "properties": {
            "star": {"type": "integer", "description": "星级 1-5"},
            "text": {"type": "string", "description": "评价原文"},
            "has_image": {"type": "boolean", "description": "是否带图"},
            "is_followup": {"type": "boolean", "description": "是否追评（差评自动升级）"},
            "order_id": {"type": "string", "description": "关联订单号，缺失时处置动作加补关联"}
          }
        },
        "maxItems": 500
      }
    }
  },
  "output": {
    "type": "object",
    "required": ["summary", "todo"],
    "properties": {
      "summary": {
        "type": "object",
        "properties": {
          "评价总数": {"type": "integer"},
          "优先级分布": {"type": "object", "description": "P0/P1/P2/好评 计数"},
          "转人工": {"type": "integer", "description": "涉诉风险词命中件数"},
          "今日告警": {"type": "string"},
          "SLA 规则": {"type": "string", "description": "P0=2h P1=12h P2=24h 好评=24h"}
        }
      },
      "todo": {
        "type": "array",
        "description": "今日必办，按 P0→P2 排序",
        "items": {
          "type": "object",
          "properties": {
            "优先级": {"type": "string", "enum": ["P0", "P1", "P2"]},
            "SLA": {"type": "string"},
            "分级": {"type": "string"},
            "处置动作": {"type": "string", "description": "安抚/申诉/转人工路由"}
          }
        }
      },
      "good_replies": {"type": "array", "description": "好评回复队列（24h 内 30-80 字）"}
    }
  },
  "scripts": {
    "run_flow": "scripts/run_flow.py",
    "usage": "python3 scripts/run_flow.py --input input.json --outdir out"
  },
  "artifacts": ["out/评价监控处置清单.xlsx", "out/评价监控处置清单.docx", "out/monitor_flow.json"],
  "constraints": {
    "max_reviews_per_day": 500,
    "sla_hours": {"P0": 2, "P1": 12, "P2": 24, "好评": 24},
    "urgent_words": ["12315", "曝光", "假货", "过敏", "腹泻", "受伤"],
    "forbidden": ["诱导晒图返利", "模板回复涉诉案件", "口头反馈入流"],
    "ai_label_required": true,
    "human_review_required": true
  }
}
