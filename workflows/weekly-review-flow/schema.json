{
  "workflow_id": "de_ecom_03_wf05",
  "name": "周报复盘",
  "type": "composite",
  "skill_refs": ["de_ecom_03_sk01", "de_ecom_03_sk02", "de_ecom_03_sk05"],
  "input": {
    "type": "object",
    "required": ["shop", "platform", "metrics", "reviews"],
    "properties": {
      "shop": {"type": "string", "description": "店铺名"},
      "platform": {"type": "string", "description": "平台"},
      "period": {"type": "string", "description": "周期，如 2026-09-22 ~ 2026-09-28"},
      "metrics": {
        "type": "object",
        "description": "本周指标",
        "properties": {
          "avg_score": {"type": "number", "description": "店铺评分，达标线 4.7"},
          "good_rate": {"type": "number", "description": "好评率，下限 0.95"},
          "bad_rate": {"type": "number", "description": "差评率，上限 0.03"},
          "total_reviews": {"type": "integer", "description": "本周评价总数"},
          "reply_rate": {"type": "number", "description": "回复率，目标 1.0"},
          "reply_hours_bad": {"type": "number", "description": "差评响应小时数，≤2"},
          "reply_hours_norm": {"type": "number", "description": "一般评价响应小时数，≤24"}
        }
      },
      "last_metrics": {"type": "object", "description": "上周指标，同结构；缺失只报本周"},
      "score_trend": {"type": "array", "items": {"type": "number"}, "description": "近 7 天评分"},
      "reviews": {
        "type": "array",
        "description": "原始评价，来自平台导出",
        "items": {
          "type": "object",
          "properties": {
            "star": {"type": "integer", "minimum": 1, "maximum": 5},
            "text": {"type": "string"},
            "has_image": {"type": "boolean"},
            "is_followup": {"type": "boolean", "description": "追评，归因权重×2"}
          }
        },
        "maxItems": 2000
      }
    }
  },
  "output": {
    "type": "object",
    "required": ["summary", "metrics", "improves"],
    "properties": {
      "summary": {
        "type": "object",
        "properties": {
          "评价总数": {"type": "integer"},
          "情感分布": {"type": "object"},
          "首要根因": {"type": "string"},
          "告警": {"type": "string", "description": "评分/差评率/回复率/趋势触发项"}
        }
      },
      "metrics": {"type": "array", "description": "指标对照，噪声 ≤2pct 标注"},
      "improves": {"type": "array", "description": "下周改进 3 项（根因/占比/动作与数字目标/责任人/时点）"}
    }
  },
  "scripts": {
    "run_flow": "scripts/run_flow.py",
    "usage": "python3 scripts/run_flow.py --input input.json --outdir out"
  },
  "artifacts": ["out/评价周报复盘.docx", "out/周报复盘数据.xlsx", "out/情感与根因图.png", "out/weekly_flow.json"],
  "constraints": {
    "baselines": {"score": 4.7, "good_rate": 0.95, "bad_rate": 0.03, "reply_rate": 1.0, "reply_hours_bad": 2},
    "noise_band": 0.02,
    "trend_days": 3,
    "followup_weight": 2,
    "forbidden": ["大促回吐判恶化", "无数字目标改进项", "估算值填充", "未脱敏引用"],
    "ai_label_required": true,
    "human_review_required": true
  }
}
